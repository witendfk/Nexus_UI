{
  "id": "reject-admission-stale-revision",
  "kind": "session-stream",
  "scenario": "commit-facts",
  "requirements": ["R5"],
  "catalog": "session-v1-form",
  "setup": {
    "fixedSurfaceId": true,
    "surface": {
      "messages": [
        {
          "version": "v0.9",
          "createSurface": {
            "surfaceId": "s-fixed-1",
            "catalogId": "https://example.com/catalogs/fixtures/session-v1/v2"
          }
        },
        {
          "version": "v0.9",
          "updateComponents": {
            "surfaceId": "s-fixed-1",
            "components": [
              { "id": "root", "component": "Column", "children": ["rating-1"] },
              {
                "id": "rating-1",
                "component": "RatingInput",
                "score": { "path": "/score" },
                "label": "评分",
                "action": {
                  "event": { "name": "rate", "context": { "score": { "path": "/score" } } }
                }
              }
            ]
          }
        },
        {
          "version": "v0.9",
          "updateDataModel": { "surfaceId": "s-fixed-1", "value": { "score": 3 } }
        }
      ]
    }
  },
  "request": {
    "kind": "action",
    "action": {
      "message": {
        "version": "v0.9",
        "action": {
          "name": "rate",
          "surfaceId": "s-fixed-1",
          "sourceComponentId": "rating-1",
          "timestamp": "2026-10-22T00:00:00.000Z",
          "context": { "score": { "path": "/score" } }
        }
      },
      "nexus": {
        "sessionVersion": 1,
        "actionId": "stale-action-1",
        "surfaceRevision": 1,
        "catalogHash": "{{catalogHash}}",
        "inputs": []
      }
    }
  },
  "steps": [
    { "enqueue": "action-A", "suspendUntil": "admission-started" },
    {
      "interleave": "generation-B",
      "note": "固定 surfaceId 工厂重建 s-fixed-1，revision 推进到 2；等价于流完成后查询前的其他提交",
      "awaitTerminal": "succeeded"
    },
    { "resume": "action-A" }
  ],
  "source": {
    "messages": [
      {
        "version": "v0.9",
        "updateDataModel": { "surfaceId": "s-fixed-1", "value": { "score": 5 } }
      }
    ]
  },
  "expected": {
    "events": [
      { "event": "start", "surfaceRevision": 1 },
      { "event": "error", "code": "RUN_ADMISSION_REJECTED", "commitState": "notCommitted" }
    ],
    "terminal": "failed",
    "commitState": "notCommitted",
    "sourceFactoryCalls": 0,
    "handlerCalls": 0,
    "surfaceRevisionAfter": 2,
    "note": "旧基准在调度内被拒：start 携带 action 声明的基准 revision 1，准入对照已推进的权威快照失败；不发布部分 UI，旧视图不得换基准"
  }
}
