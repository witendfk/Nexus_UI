# Nexus UI server local configuration.
# Copy or edit the repository root .env; it is git-ignored and not exposed to Vite client code.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
PORT=3001
# Optional local persistence. Leave empty to keep surface history in memory.
# NEXUS_HISTORY_FILE=.nexus/surface-history.json
# Optional reference-server request limits. Defaults: 1048576 bytes and 10000ms.
# NEXUS_MAX_REQUEST_BODY_BYTES=1048576
# NEXUS_REQUEST_TIMEOUT_MS=10000
