{
  "name": "@nexus-ui/playground",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus UI Playground —— 对话生成 / 组件画廊 / 协议调试面板（Vite + React）。",
  "type": "module",
  "main": "./src/entry/main.tsx",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@nexus-ui/core": "workspace:*",
    "@nexus-ui/react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^1.6.0"
  }
}
