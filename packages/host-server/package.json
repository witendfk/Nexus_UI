  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
