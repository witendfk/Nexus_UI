{
  "//": "构建用：仅编译 src，产出 dist（声明 + sourcemap）。测试不进产物。",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
