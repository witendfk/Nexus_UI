{
  "name": "@nexus-ui/core",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus UI 内核 —— 框架无关的 A2UI v0.9 流式协议运行时（仅依赖 zustand）。",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS='--import tsx --no-warnings' mocha",
    "test:coverage": "NODE_OPTIONS='--import tsx --no-warnings' c8 mocha",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/chai": "^5.2.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "^18.19.50",
    "c8": "^9.1.0",
    "chai": "^5.1.1",
    "mocha": "^10.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
