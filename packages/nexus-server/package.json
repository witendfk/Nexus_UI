{
  "name": "@nexus-ui/server",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus UI server SDK：Agent 装配、guard、SSE 传输与宿主显式注入契约（参考服务在 examples/playground-server）。",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm --filter @nexus-ui/core build && rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist",
    "test": "tsx --test tests/*.test.ts test/**/*.test.ts test/*.test.ts",
    "lint": "eslint src tests test --ext .ts"
  },
  "dependencies": {
    "@nexus-ui/core": "workspace:*",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.1",
    "koa": "^2.15.3"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^18.19.50",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
