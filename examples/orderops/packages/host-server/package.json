{
  "name": "@orderops/host-server",
  "version": "0.1.0",
  "private": true,
  "description": "OrderOps Host — 组装 Nexus UI 受控装配 API，持有订单/物流/工单事实与 SQLite 领域幂等。",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@koa/router": "^12.0.2",
    "@nexus-ui/core": "workspace:*",
    "@nexus-ui/server": "workspace:*",
    "@orderops/contracts": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "koa": "^2.16.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/koa": "^2.15.2",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
